RewriteEngine On
RewriteBase /

# ================================================
# 1. BOTS KE LIYE SIRF SCHOLAR PAGE DIKHAO
# ================================================
RewriteCond %{HTTP_USER_AGENT} Googlebot|bingbot|Slurp|DuckDuckBot|Baiduspider|YandexBot|facebookexternalhit|twitterbot [NC]
RewriteRule ^journal/jics/articles/([a-f0-9]{24})(/.*)?$ /scholar/article/$1 [R=302,L]

# ================================================
# 2. NORMAL USERS KE LIYE — DIRECT REACT APP (NO REDIRECT, ZERO LOADING)
# ================================================
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.html [L]

# ================================================
# 3. SCHOLAR ROUTE — SIRF BOTS KE LIYE (HUMANS KO KABHI NA DIKHE)
# ================================================
RewriteRule ^scholar/article/(.+)$ https://api.synergyworldpress.com/scholar/article/$1 [R=301,L]

# ================================================
# 4. SITEMAP & ROBOTS
# ================================================
RewriteRule ^sitemap\.xml$ https://api.synergyworldpress.com/sitemap.xml [R=301,L]
RewriteRule ^robots\.txt$ https://api.synergyworldpress.com/robots.txt [R=301,L]