RewriteEngine On
RewriteBase /

# ================================================
# 1. Sitemap & robots.txt — Redirect to API
# ================================================
RewriteRule ^sitemap\.xml$ https://api.synergyworldpress.com/sitemap.xml [R=301,L]
RewriteRule ^robots\.txt$ https://api.synergyworldpress.com/robots.txt [R=301,L]

# ================================================
# 2. Scholar articles — sirf bots ke liye (Redirect)
# ================================================
RewriteCond %{HTTP_USER_AGENT} (Googlebot|bingbot|Slurp|DuckDuckBot|Baiduspider|YandexBot|facebookexternalhit|twitterbot|linkedinbot) [NC]
RewriteRule ^journal/jics/articles/([a-f0-9]{24})/?$ https://api.synergyworldpress.com/scholar/article/$1 [R=302,L]

# ================================================
# 3. Static files — serve directly
# ================================================
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# ================================================
# 4. React App — all other routes
# ================================================
RewriteRule ^ index.html [L]