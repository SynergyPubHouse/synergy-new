# Backend Configuration
PORT=5000
NODE_ENV=production
MONGO_URI=your_mongo_uri_here
JWT_SECRET=your_jwt_secret_here
FRONTEND_URL=https://your-frontend.example.com

# Email Configuration
EMAIL_HOST=smtp.hostinger.com
EMAIL_PORT=465
EMAIL_USER=noreply@synergyworldpress.com
EMAIL_PASS=your_existing_password_here
EMAIL_FROM=official_project_email@synergyworldpress.com
EMAIL_FROM_NAME=Synergy World Press

# Google OAuth (if using Google Sign-In)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Cloudinary (if using for file uploads)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
